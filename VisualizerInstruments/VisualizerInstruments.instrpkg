        <!--
        Symbols panel: Time-Profiler-style rollup grouped by the
        text-symbol code-location. Aggregation rows render the
        symbol with the focus arrow + click-to-source affordance.
        -->
        <!--        <aggregation>-->
        <!--            <title>Symbols</title>-->
        <!--            <table-ref>actor-table</table-ref>-->
        <!--            <hierarchy>-->
        <!--                <level>-->
        <!--                    <column>code-location</column>-->
        <!--                </level>-->
        <!--            </hierarchy>-->
        <!--            <column>-->
        <!--                <title>Count</title>-->
        <!--                <count/>-->
        <!--            </column>-->
        <!--            <column>-->
        <!--                <title>Total duration</title>-->
        <!--                <sum>duration</sum>-->
        <!--            </column>-->
        <!--        </aggregation>-->
        
        <!--
        Call tree built from the synthetic 1-frame backtrace defined
        on the actor schema. Each "stack" is a single frame, but the
        view gives the inline source-jump arrow that <list> cells
        don't render. Categorized by role, weighted by duration.
        -->
        <calltree>
            <title>Call Tree</title>
            <table-ref>actor-table</table-ref>
            <backtrace-column>code-backtrace</backtrace-column>
            <thread-column>actor-thread</thread-column>
            <category-column>conversation-id</category-column>
            <weight-column>duration</weight-column>
        </calltree>
        
        <!--
        Token Call Tree: same Conversation → Actor run → call site hierarchy
        as the Conversation Tree aggregation, but rendered as a calltree so
        each row carries the inline source-jump arrow. Category groups by
        conversation; the 2-frame backtrace groups tokens under their actor
        run (frame[1] = actorID virtual address) with the actual emit call
        site as the leaf (frame[0]).
        -->
        <calltree>
            <title>Token Call Tree</title>
            <table-ref>token-table</table-ref>
            <backtrace-column>token-backtrace</backtrace-column>
            <thread-column>token-thread</thread-column>
            <category-column>conversation-id</category-column>
        </calltree>
    </instrument>
    
    <!--
    ============================================================
    TEMPLATE
    ============================================================
    Imports the bundled .tracetemplate so this package shows up as
    a runnable template in Instruments' template chooser.
    -->
    <template>
        <import-from-file>LLM Observation.tracetemplate</import-from-file>
    </template>
    
</package>
